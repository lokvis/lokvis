{
  "name": "@lokvis/browser-adapter",
  "version": "0.8.1",
  "description": "Lokvis Browser Adapter - the only non-presentation package allowed to touch raw browser APIs",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./test-utils": {
      "types": "./src/test-utils.ts",
      "import": "./src/test-utils.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "dexie": "^4.0.10"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./test-utils": {
        "types": "./dist/test-utils.d.ts",
        "import": "./dist/test-utils.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lokvis/lokvis.git",
    "directory": "packages/browser-adapter"
  }
}
