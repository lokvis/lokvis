{
  "name": "@lokvis/plugin-image",
  "version": "0.4.1",
  "description": "Lokvis Image Tools Plugin - resize / compress / convert / crop / rotate / flip / watermark / background",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node-plugin.ts",
      "import": "./src/node-plugin.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lokvis/schema": "workspace:*",
    "@lokvis/plugin-sdk": "workspace:*",
    "@lokvis/capability": "workspace:*",
    "@lokvis/engine-image": "workspace:*",
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node-plugin.d.ts",
        "import": "./dist/node-plugin.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lokvis/lokvis.git",
    "directory": "packages/plugin-image"
  }
}
