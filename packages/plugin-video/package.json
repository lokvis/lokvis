{
  "name": "@lokvis/plugin-video",
  "version": "0.5.2",
  "description": "Lokvis Video Tools Plugin - compress / transcode / trim / merge / extract-audio / to-gif / screenshot",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./web": {
      "types": "./src/web-plugin.ts",
      "import": "./src/web-plugin.ts"
    },
    "./node": {
      "types": "./src/node-plugin.ts",
      "import": "./src/node-plugin.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lokvis/schema": "workspace:*",
    "@lokvis/plugin-sdk": "workspace:*",
    "@lokvis/capability": "workspace:*",
    "@lokvis/engine-video": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@ffmpeg/ffmpeg": "^0.12.0",
    "@ffmpeg/util": "^0.12.0",
    "ffmpeg-static": "^5.2.0"
  },
  "peerDependenciesMeta": {
    "@ffmpeg/ffmpeg": {
      "optional": true
    },
    "@ffmpeg/util": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./web": {
        "types": "./dist/web-plugin.d.ts",
        "import": "./dist/web-plugin.js"
      },
      "./node": {
        "types": "./dist/node-plugin.d.ts",
        "import": "./dist/node-plugin.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lokvis/lokvis.git",
    "directory": "packages/plugin-video"
  }
}
