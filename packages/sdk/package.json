{
  "name": "@lokvis/sdk",
  "version": "0.10.0",
  "description": "Lokvis SDK - Embed Lokvis Runtime in any web app",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./image": {
      "types": "./src/presets/image.ts",
      "import": "./src/presets/image.ts"
    },
    "./video": {
      "types": "./src/presets/video.ts",
      "import": "./src/presets/video.ts"
    },
    "./pdf": {
      "types": "./src/presets/pdf.ts",
      "import": "./src/presets/pdf.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lokvis/engine-video": "workspace:*",
    "@lokvis/plugin-image": "workspace:*",
    "@lokvis/plugin-pdf": "workspace:*",
    "@lokvis/plugin-video": "workspace:*",
    "@lokvis/schema": "workspace:*",
    "@lokvis/runtime": "workspace:*",
    "@lokvis/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./image": {
        "types": "./dist/presets/image.d.ts",
        "import": "./dist/presets/image.js"
      },
      "./video": {
        "types": "./dist/presets/video.d.ts",
        "import": "./dist/presets/video.js"
      },
      "./pdf": {
        "types": "./dist/presets/pdf.d.ts",
        "import": "./dist/presets/pdf.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lokvis/lokvis.git",
    "directory": "packages/sdk"
  }
}
