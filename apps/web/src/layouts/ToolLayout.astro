---
import BaseLayout from './BaseLayout.astro';

interface Props {
  tool: string;
  category: string;
  title: string;
  description: string;
}

const { tool, category, title, description } = Astro.props;
---

<BaseLayout title={`${title} - Lokvis`} description={description}>
  <header class="border-b border-zinc-200 dark:border-zinc-800">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold">
        <span class="text-xl">◆</span>
        <span>Lokvis</span>
      </a>
      <a href="/workspace" class="text-sm hover:text-indigo-500">Open Workspace →</a>
    </nav>
  </header>

  <main class="mx-auto max-w-4xl px-6 py-12">
    <nav class="mb-4 text-sm text-zinc-500">
      <a href="/" class="hover:text-indigo-500">Home</a>
      <span> / </span>
      <a href={`/${category}`} class="hover:text-indigo-500 capitalize">{category}</a>
      <span> / </span>
      <span class="capitalize">{tool}</span>
    </nav>

    <h1 class="mb-4 text-4xl font-bold">{title}</h1>
    <p class="mb-8 text-lg text-zinc-600 dark:text-zinc-400">{description}</p>

    <div class="rounded-lg border border-zinc-200 bg-white p-8 dark:border-zinc-800 dark:bg-zinc-900">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold">Process locally in your browser</h2>
        <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-800 dark:bg-green-900 dark:text-green-200">
          100% Private
        </span>
      </div>
      <p class="mb-6 text-sm text-zinc-500">
        This tool runs entirely in your browser. Your files are never uploaded to any server.
      </p>
      <a
        href={`/workspace?tool=${category}.${tool}`}
        class="inline-block rounded-md bg-indigo-600 px-6 py-3 text-white hover:bg-indigo-500"
      >
        Launch Tool
      </a>
    </div>

    <!-- SEO Content -->
    <div class="mt-12 prose dark:prose-invert max-w-none">
      <h2>How it works</h2>
      <p>
        Lokvis processes your files locally using WebAssembly. When you launch the tool,
        the required engine (e.g., Squoosh for images, FFmpeg for video) is loaded into your browser.
        All processing happens on your device — no uploads, no servers.
      </p>

      <h2>Why use Lokvis?</h2>
      <ul>
        <li><strong>Privacy:</strong> Your files never leave your device.</li>
        <li><strong>Speed:</strong> No upload time means instant processing.</li>
        <li><strong>Free:</strong> Core tools are free forever, no account required.</li>
        <li><strong>Offline:</strong> Install as PWA and use without internet.</li>
      </ul>
    </div>
  </main>
</BaseLayout>
