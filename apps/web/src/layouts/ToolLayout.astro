---
import BaseLayout from './BaseLayout.astro';

interface Props {
  tool: string;
  category: string;
  title: string;
  description: string;
}

const { tool, category, title, description } = Astro.props;
---

<BaseLayout title={`${title} - Lokvis`} description={description}>
  <header class="sticky top-0 z-50 border-b border-lokvis-border glass-card">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="text-xl text-gradient">◆</span>
        <span>Lokvis</span>
      </a>
      <a href="/workspace" class="flex items-center gap-1.5 text-sm font-medium transition-colors hover:text-indigo-500">
        Open Workspace
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </nav>
  </header>

  <main class="mx-auto max-w-4xl px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-sm text-lokvis-muted animate-fade-in">
      <a href="/" class="transition-colors hover:text-indigo-500">Home</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <a href={`/${category}`} class="transition-colors hover:text-indigo-500 capitalize">{category}</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="capitalize text-lokvis-fg">{tool}</span>
    </nav>

    <!-- Title -->
    <div class="mb-8 animate-fade-in-up">
      <h1 class="mb-3 text-4xl font-bold tracking-tight">{title}</h1>
      <p class="text-lg leading-relaxed text-lokvis-muted">{description}</p>
    </div>

    <!-- Steps -->
    <div class="mb-8 grid gap-4 md:grid-cols-3 animate-fade-in-up stagger">
      <div class="flex items-start gap-4 rounded-2xl border border-lokvis-border bg-lokvis-card p-5">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-bold text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400">1</div>
        <div>
          <h3 class="mb-1 text-sm font-semibold">Select files</h3>
          <p class="text-xs text-lokvis-muted">Drag & drop or click to upload from your device.</p>
        </div>
      </div>
      <div class="flex items-start gap-4 rounded-2xl border border-lokvis-border bg-lokvis-card p-5">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-bold text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400">2</div>
        <div>
          <h3 class="mb-1 text-sm font-semibold">Configure</h3>
          <p class="text-xs text-lokvis-muted">Adjust settings and parameters to your needs.</p>
        </div>
      </div>
      <div class="flex items-start gap-4 rounded-2xl border border-lokvis-border bg-lokvis-card p-5">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-bold text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400">3</div>
        <div>
          <h3 class="mb-1 text-sm font-semibold">Download</h3>
          <p class="text-xs text-lokvis-muted">Process locally, then save the result to your device.</p>
        </div>
      </div>
    </div>

    <!-- Launch Card -->
    <div class="animate-fade-in-up overflow-hidden rounded-2xl border border-lokvis-border bg-lokvis-card">
      <div class="border-b border-lokvis-border bg-lokvis-surface px-6 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <span class="text-sm font-medium">Ready to process</span>
          </div>
          <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">
            100% Private
          </span>
        </div>
      </div>
      <div class="flex flex-col items-center justify-center px-6 py-12 text-center">
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
        </div>
        <p class="mb-6 text-sm text-lokvis-muted">
          Launch the tool workspace. All processing happens in your browser.
        </p>
        <a
          href={`/workspace?tool=${category}.${tool}`}
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-8 py-3 font-medium text-white shadow-lg shadow-indigo-500/30 transition-all hover:bg-indigo-500 hover:shadow-xl hover:shadow-indigo-500/40"
        >
          Launch Tool
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- SEO Content -->
    <div class="mt-16 max-w-none">
      <h2 class="mb-4 text-2xl font-bold tracking-tight">How it works</h2>
      <p class="mb-6 leading-relaxed text-lokvis-muted">
        Lokvis processes your files locally using WebAssembly. When you launch the tool,
        the required engine (e.g., Canvas for images, FFmpeg for video) is loaded into your browser.
        All processing happens on your device &mdash; no uploads, no servers.
      </p>

      <h2 class="mb-4 text-2xl font-bold tracking-tight">Why use Lokvis?</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="flex items-start gap-3 rounded-xl border border-lokvis-border bg-lokvis-card p-4">
          <svg class="mt-0.5 shrink-0 text-emerald-500" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          <div>
            <h4 class="mb-0.5 text-sm font-semibold">Privacy</h4>
            <p class="text-xs text-lokvis-muted">Your files never leave your device.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-lokvis-border bg-lokvis-card p-4">
          <svg class="mt-0.5 shrink-0 text-emerald-500" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          <div>
            <h4 class="mb-0.5 text-sm font-semibold">Speed</h4>
            <p class="text-xs text-lokvis-muted">No upload time means instant processing.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-lokvis-border bg-lokvis-card p-4">
          <svg class="mt-0.5 shrink-0 text-emerald-500" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          <div>
            <h4 class="mb-0.5 text-sm font-semibold">Free</h4>
            <p class="text-xs text-lokvis-muted">Core tools are free forever, no account required.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-lokvis-border bg-lokvis-card p-4">
          <svg class="mt-0.5 shrink-0 text-emerald-500" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          <div>
            <h4 class="mb-0.5 text-sm font-semibold">Offline</h4>
            <p class="text-xs text-lokvis-muted">Install as PWA and use without internet.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
