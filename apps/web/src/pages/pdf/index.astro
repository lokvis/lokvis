---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  { slug: 'merge', name: 'Merge PDF', description: 'Combine multiple PDF files into a single document, locally in your browser.', icon: 'merge' },
];

const iconMap: Record<string, string> = {
  merge: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 18v-6"/><path d="m14 18-2-2 2-2"/>',
};
---

<BaseLayout title="PDF Tools - Lokvis" description="Free, private PDF tools that run entirely in your browser. No uploads, no servers.">
  <header class="sticky top-0 z-50 border-b border-lokvis-border glass-card">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="text-xl text-gradient">◆</span>
        <span>Lokvis</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="/image" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">Image</a>
        <a href="/pdf" class="rounded-md bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400">PDF</a>
        <a href="/video" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">Video</a>
        <a href="/workspace" class="ml-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm shadow-indigo-500/20 transition-all hover:bg-indigo-500 hover:shadow-md hover:shadow-indigo-500/25">
          Open Workspace
        </a>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-6xl px-6 py-16">
    <nav class="mb-6 flex items-center gap-2 text-sm text-lokvis-muted animate-fade-in">
      <a href="/" class="transition-colors hover:text-indigo-500">Home</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-lokvis-fg font-medium">PDF</span>
    </nav>

    <div class="mb-12 animate-fade-in-up">
      <div class="mb-4 flex items-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
        </div>
        <div>
          <h1 class="text-4xl font-bold tracking-tight">PDF Tools</h1>
          <p class="mt-1 text-lokvis-muted">Process PDFs entirely in your browser. No uploads, no servers, 100% private.</p>
        </div>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 stagger">
      {tools.map((tool) => (
        <a
          href={`/pdf/${tool.slug}`}
          class="animate-fade-in-up group relative overflow-hidden rounded-2xl border border-lokvis-border bg-lokvis-card p-8 transition-all hover:border-emerald-200 hover:shadow-lg hover:shadow-emerald-500/5 dark:hover:border-emerald-800"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100 dark:from-emerald-500/10"></div>
          <div class="relative">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 transition-colors group-hover:bg-emerald-100 dark:bg-emerald-950/50 dark:text-emerald-400 dark:group-hover:bg-emerald-900/50">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconMap[tool.icon]}></svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold">{tool.name}</h3>
            <p class="text-sm leading-relaxed text-lokvis-muted">{tool.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-medium text-emerald-600 opacity-0 transition-all group-hover:opacity-100 dark:text-emerald-400">
              Open tool
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
