---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  { slug: 'compress', name: 'Compress Video', description: 'Reduce video file size using WebAssembly FFmpeg. Adjust quality and resolution.', icon: 'compress' },
];

const iconMap: Record<string, string> = {
  compress: '<path d="m4 14 6 6v-6"/><path d="M20 10h-7a2 2 0 0 1-2-2V1"/><path d="m14 10 7-7"/><path d="M15 2h6v6"/>',
};
---

<BaseLayout title="Video Tools - Lokvis" description="Free, private video tools that run entirely in your browser. No uploads, no servers.">
  <header class="sticky top-0 z-50 border-b border-lokvis-border glass-card">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="text-xl text-gradient">◆</span>
        <span>Lokvis</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="/image" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">Image</a>
        <a href="/pdf" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">PDF</a>
        <a href="/video" class="rounded-md bg-rose-50 px-3 py-2 text-sm font-medium text-rose-600 dark:bg-rose-950/50 dark:text-rose-400">Video</a>
        <a href="/workspace" class="ml-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm shadow-indigo-500/20 transition-all hover:bg-indigo-500 hover:shadow-md hover:shadow-indigo-500/25">
          Open Workspace
        </a>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-6xl px-6 py-16">
    <nav class="mb-6 flex items-center gap-2 text-sm text-lokvis-muted animate-fade-in">
      <a href="/" class="transition-colors hover:text-indigo-500">Home</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-lokvis-fg font-medium">Video</span>
    </nav>

    <div class="mb-12 animate-fade-in-up">
      <div class="mb-4 flex items-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-rose-50 text-rose-600 dark:bg-rose-950/50 dark:text-rose-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
        </div>
        <div>
          <h1 class="text-4xl font-bold tracking-tight">Video Tools</h1>
          <p class="mt-1 text-lokvis-muted">Process videos entirely in your browser. No uploads, no servers, 100% private.</p>
        </div>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 stagger">
      {tools.map((tool) => (
        <a
          href={`/video/${tool.slug}`}
          class="animate-fade-in-up group relative overflow-hidden rounded-2xl border border-lokvis-border bg-lokvis-card p-8 transition-all hover:border-rose-200 hover:shadow-lg hover:shadow-rose-500/5 dark:hover:border-rose-800"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-rose-500/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100 dark:from-rose-500/10"></div>
          <div class="relative">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-rose-50 text-rose-600 transition-colors group-hover:bg-rose-100 dark:bg-rose-950/50 dark:text-rose-400 dark:group-hover:bg-rose-900/50">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconMap[tool.icon]}></svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold">{tool.name}</h3>
            <p class="text-sm leading-relaxed text-lokvis-muted">{tool.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-medium text-rose-600 opacity-0 transition-all group-hover:opacity-100 dark:text-rose-400">
              Open tool
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
