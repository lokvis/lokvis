---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Lokvis">
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center px-6 text-center">
    <div class="mb-4 text-6xl">◆</div>
    <h1 class="mb-4 text-4xl font-bold">404</h1>
    <p class="mb-8 text-zinc-600 dark:text-zinc-400">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="rounded-md bg-indigo-600 px-6 py-3 text-white hover:bg-indigo-500"
    >
      Back to Home
    </a>
  </main>
</BaseLayout>
