---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <header class="border-b border-zinc-200 dark:border-zinc-800">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold">
        <span class="text-xl">◆</span>
        <span>Lokvis</span>
      </a>
      <div class="flex items-center gap-6 text-sm">
        <a href="/image" class="hover:text-indigo-500">Image</a>
        <a href="/pdf" class="hover:text-indigo-500">PDF</a>
        <a href="/video" class="hover:text-indigo-500">Video</a>
        <a href="/workflows" class="hover:text-indigo-500">Workflows</a>
        <a
          href="/workspace"
          class="rounded-md bg-zinc-900 px-4 py-2 text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900"
        >
          Open Workspace
        </a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-6 py-24">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="mb-6 inline-block rounded-full bg-indigo-50 px-3 py-1 text-sm text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300"
        >
          Local-first Browser Workspace
        </span>
        <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-6xl">
          Everything runs in your browser.
        </h1>
        <p class="mb-8 text-lg text-zinc-600 dark:text-zinc-400">
          No uploads. No servers. No compromises.
          Process images, videos, PDFs, and audio files entirely on your device.
        </p>
        <div class="flex justify-center gap-4">
          <a
            href="/workspace"
            class="rounded-md bg-indigo-600 px-6 py-3 text-white hover:bg-indigo-500"
          >
            Launch Workspace
          </a>
          <a
            href="/docs"
            class="rounded-md border border-zinc-300 px-6 py-3 hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-800"
          >
            Documentation
          </a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-lg border border-zinc-200 p-6 dark:border-zinc-800">
          <div class="mb-4 text-2xl">🔒</div>
          <h3 class="mb-2 text-lg font-semibold">Privacy by Design</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Your files never leave your device. All processing happens locally in
            the browser via WebAssembly.
          </p>
        </div>
        <div class="rounded-lg border border-zinc-200 p-6 dark:border-zinc-800">
          <div class="mb-4 text-2xl">⚡</div>
          <h3 class="mb-2 text-lg font-semibold">Zero Latency</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            No upload time. No server queue. Processing starts instantly on your
            device.
          </p>
        </div>
        <div class="rounded-lg border border-zinc-200 p-6 dark:border-zinc-800">
          <div class="mb-4 text-2xl">🧩</div>
          <h3 class="mb-2 text-lg font-semibold">Workflow Ecosystem</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Build, save, and share workflows. Extend with plugins. Powered by an
            open Runtime.
          </p>
        </div>
      </div>
    </section>

    <!-- Tools Grid -->
    <section class="mx-auto max-w-6xl px-6 py-16">
      <h2 class="mb-8 text-center text-3xl font-bold">Available Workspaces</h2>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <a
          href="/image/compress"
          class="block rounded-lg border border-zinc-200 p-6 transition-shadow hover:shadow-md dark:border-zinc-800"
        >
          <div class="mb-2 text-xl">🖼️</div>
          <h3 class="font-semibold">Image Tools</h3>
          <p class="text-sm text-zinc-500">Compress, resize, convert</p>
        </a>
        <a
          href="/video/compress"
          class="block rounded-lg border border-zinc-200 p-6 transition-shadow hover:shadow-md dark:border-zinc-800"
        >
          <div class="mb-2 text-xl">🎬</div>
          <h3 class="font-semibold">Video Tools</h3>
          <p class="text-sm text-zinc-500">Compress, trim, convert</p>
        </a>
        <a
          href="/pdf/merge"
          class="block rounded-lg border border-zinc-200 p-6 transition-shadow hover:shadow-md dark:border-zinc-800"
        >
          <div class="mb-2 text-xl">📄</div>
          <h3 class="font-semibold">PDF Tools</h3>
          <p class="text-sm text-zinc-500">Merge, split, compress</p>
        </a>
        <a
          href="/audio/trim"
          class="block rounded-lg border border-zinc-200 p-6 transition-shadow hover:shadow-md dark:border-zinc-800"
        >
          <div class="mb-2 text-xl">🎵</div>
          <h3 class="font-semibold">Audio Tools</h3>
          <p class="text-sm text-zinc-500">Trim, normalize, convert</p>
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-zinc-200 dark:border-zinc-800">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-zinc-500 md:flex-row"
    >
      <div class="flex items-center gap-2">
        <span>◆</span>
        <span>Lokvis</span>
        <span>·</span>
        <span>Local Vision, Browser Workspace</span>
      </div>
      <div class="flex gap-6">
        <a href="/docs" class="hover:text-zinc-900 dark:hover:text-zinc-100">Docs</a>
        <a href="/workflows" class="hover:text-zinc-900 dark:hover:text-zinc-100">Workflows</a>
        <a href="https://github.com/lokvis" class="hover:text-zinc-900 dark:hover:text-zinc-100">GitHub</a>
      </div>
    </div>
  </footer>
</BaseLayout>
