---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <header class="sticky top-0 z-50 border-b border-lokvis-border glass-card">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="text-xl text-gradient">◆</span>
        <span>Lokvis</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="/image" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">Image</a>
        <a href="/pdf" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">PDF</a>
        <a href="/video" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">Video</a>
        <a href="/docs" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">Docs</a>
        <a
          href="/workspace"
          class="ml-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm shadow-indigo-500/20 transition-all hover:bg-indigo-500 hover:shadow-md hover:shadow-indigo-500/25"
        >
          Open Workspace
        </a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="bg-dots absolute inset-0 opacity-40"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-indigo-500/5 via-transparent to-transparent dark:from-indigo-500/10"></div>
      <section class="relative mx-auto max-w-6xl px-6 pt-24 pb-32">
        <div class="mx-auto max-w-3xl text-center animate-fade-in-up">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1.5 text-sm text-indigo-700 dark:border-indigo-800 dark:bg-indigo-950/50 dark:text-indigo-300">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-indigo-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-indigo-500"></span>
            </span>
            Local-first Browser Workspace
          </div>
          <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-6xl lg:text-7xl">
            Everything runs
            <br />
            <span class="text-gradient">in your browser.</span>
          </h1>
          <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-lokvis-muted">
            No uploads. No servers. No compromises.
            Process images, videos, PDFs, and audio files entirely on your device.
          </p>
          <div class="flex items-center justify-center gap-4">
            <a
              href="/workspace"
              class="group relative rounded-xl bg-indigo-600 px-8 py-3.5 text-base font-medium text-white shadow-lg shadow-indigo-500/30 transition-all hover:bg-indigo-500 hover:shadow-xl hover:shadow-indigo-500/40"
            >
              Launch Workspace
              <span class="ml-2 inline-block transition-transform group-hover:translate-x-0.5">&rarr;</span>
            </a>
            <a
              href="/docs"
              class="rounded-xl border border-lokvis-border bg-white/60 px-8 py-3.5 text-base font-medium transition-all hover:border-zinc-300 hover:bg-white hover:shadow-sm dark:border-zinc-700 dark:bg-zinc-900/60 dark:hover:border-zinc-600 dark:hover:bg-zinc-900"
            >
              Documentation
            </a>
          </div>
        </div>
      </section>
    </section>

    <!-- Features -->
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-12 text-center">
        <h2 class="mb-3 text-3xl font-bold tracking-tight">Why Lokvis?</h2>
        <p class="text-lokvis-muted">Built for speed, privacy, and extensibility.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3 stagger">
        <div class="animate-fade-in-up group rounded-2xl border border-lokvis-border bg-lokvis-card p-8 transition-all hover:border-indigo-200 hover:shadow-lg hover:shadow-indigo-500/5 dark:hover:border-indigo-800">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 transition-colors group-hover:bg-indigo-100 dark:bg-indigo-950/50 dark:text-indigo-400 dark:group-hover:bg-indigo-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold">Privacy by Design</h3>
          <p class="text-sm leading-relaxed text-lokvis-muted">
            Your files never leave your device. All processing happens locally in
            the browser via WebAssembly. Zero server-side storage.
          </p>
        </div>
        <div class="animate-fade-in-up group rounded-2xl border border-lokvis-border bg-lokvis-card p-8 transition-all hover:border-amber-200 hover:shadow-lg hover:shadow-amber-500/5 dark:hover:border-amber-800">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-600 transition-colors group-hover:bg-amber-100 dark:bg-amber-950/50 dark:text-amber-400 dark:group-hover:bg-amber-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold">Zero Latency</h3>
          <p class="text-sm leading-relaxed text-lokvis-muted">
            No upload time. No server queue. No network dependency.
            Processing starts instantly on your device, at native speed.
          </p>
        </div>
        <div class="animate-fade-in-up group rounded-2xl border border-lokvis-border bg-lokvis-card p-8 transition-all hover:border-violet-200 hover:shadow-lg hover:shadow-violet-500/5 dark:hover:border-violet-800">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-violet-50 text-violet-600 transition-colors group-hover:bg-violet-100 dark:bg-violet-950/50 dark:text-violet-400 dark:group-hover:bg-violet-900/50">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold">Plugin Ecosystem</h3>
          <p class="text-sm leading-relaxed text-lokvis-muted">
            Build, save, and share workflows. Extend with plugins.
            Powered by an open Runtime with standardized capabilities.
          </p>
        </div>
      </div>
    </section>

    <!-- Tools Grid -->
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-12 text-center">
        <h2 class="mb-3 text-3xl font-bold tracking-tight">Available Tools</h2>
        <p class="text-lokvis-muted">Pick a tool, drop your file, done.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 stagger">
        <a
          href="/image/compress"
          class="animate-fade-in-up group relative overflow-hidden rounded-2xl border border-lokvis-border bg-lokvis-card p-6 transition-all hover:border-indigo-200 hover:shadow-lg hover:shadow-indigo-500/5 dark:hover:border-indigo-800"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100 dark:from-indigo-500/10"></div>
          <div class="relative">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
            <h3 class="mb-1 font-semibold">Image Tools</h3>
            <p class="text-sm text-lokvis-muted">Compress, resize, convert</p>
          </div>
        </a>
        <a
          href="/video/compress"
          class="animate-fade-in-up group relative overflow-hidden rounded-2xl border border-lokvis-border bg-lokvis-card p-6 transition-all hover:border-rose-200 hover:shadow-lg hover:shadow-rose-500/5 dark:hover:border-rose-800"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-rose-500/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100 dark:from-rose-500/10"></div>
          <div class="relative">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-rose-50 text-rose-600 dark:bg-rose-950/50 dark:text-rose-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
            </div>
            <h3 class="mb-1 font-semibold">Video Tools</h3>
            <p class="text-sm text-lokvis-muted">Compress, trim, convert</p>
          </div>
        </a>
        <a
          href="/pdf/merge"
          class="animate-fade-in-up group relative overflow-hidden rounded-2xl border border-lokvis-border bg-lokvis-card p-6 transition-all hover:border-emerald-200 hover:shadow-lg hover:shadow-emerald-500/5 dark:hover:border-emerald-800"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100 dark:from-emerald-500/10"></div>
          <div class="relative">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 18v-6"/><path d="m14 18-2-2 2-2"/></svg>
            </div>
            <h3 class="mb-1 font-semibold">PDF Tools</h3>
            <p class="text-sm text-lokvis-muted">Merge, split, compress</p>
          </div>
        </a>
        <a
          href="/workspace"
          class="animate-fade-in-up group relative overflow-hidden rounded-2xl border border-lokvis-border bg-lokvis-card p-6 transition-all hover:border-amber-200 hover:shadow-lg hover:shadow-amber-500/5 dark:hover:border-amber-800"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100 dark:from-amber-500/10"></div>
          <div class="relative">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-950/50 dark:text-amber-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/></svg>
            </div>
            <h3 class="mb-1 font-semibold">Full Workspace</h3>
            <p class="text-sm text-lokvis-muted">All tools in one place</p>
          </div>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 to-violet-700 px-8 py-16 text-center text-white shadow-2xl shadow-indigo-500/20">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_40%,rgba(255,255,255,0.1),transparent)]"></div>
        <div class="relative">
          <h2 class="mb-4 text-3xl font-bold tracking-tight">Start processing files locally</h2>
          <p class="mx-auto mb-8 max-w-lg text-indigo-100">
            No sign-up required. No files uploaded. Just open and use.
          </p>
          <a
            href="/workspace"
            class="inline-flex items-center gap-2 rounded-xl bg-white px-8 py-3.5 text-base font-semibold text-indigo-700 shadow-lg transition-all hover:bg-indigo-50 hover:shadow-xl"
          >
            Launch Now
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-lokvis-border">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-lokvis-muted md:flex-row"
    >
      <div class="flex items-center gap-2">
        <span class="text-gradient">◆</span>
        <span class="font-medium text-lokvis-fg">Lokvis</span>
        <span class="text-lokvis-border">&middot;</span>
        <span>Local Vision, Browser Workspace</span>
      </div>
      <div class="flex gap-6">
        <a href="/docs" class="transition-colors hover:text-indigo-500">Docs</a>
        <a href="https://github.com/lokvis" class="transition-colors hover:text-indigo-500">GitHub</a>
        <span class="text-lokvis-border">&middot;</span>
        <span class="text-xs">MIT License</span>
      </div>
    </div>
  </footer>
</BaseLayout>
