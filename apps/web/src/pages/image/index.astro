---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  { slug: 'compress', name: 'Compress Image', description: 'Reduce file size with quality control. Supports PNG, JPEG, WebP, and AVIF.', icon: 'compress' },
  { slug: 'resize', name: 'Resize Image', description: 'Change dimensions with smart fit strategies. Batch processing supported.', icon: 'resize' },
];

const iconMap: Record<string, string> = {
  compress: '<path d="m4 14 6 6v-6"/><path d="M20 10h-7a2 2 0 0 1-2-2V1"/><path d="m14 10 7-7"/><path d="M15 2h6v6"/>',
  resize: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M21 3h-6"/><path d="M21 3v6"/><path d="M3 21h6"/><path d="M3 21v-6"/>',
};
---

<BaseLayout title="Image Tools - Lokvis" description="Free, private image tools that run entirely in your browser. No uploads, no servers.">
  <header class="sticky top-0 z-50 border-b border-lokvis-border glass-card">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="text-xl text-gradient">◆</span>
        <span>Lokvis</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="/image" class="rounded-md bg-indigo-50 px-3 py-2 text-sm font-medium text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400">Image</a>
        <a href="/pdf" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">PDF</a>
        <a href="/video" class="rounded-md px-3 py-2 text-sm transition-colors hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400">Video</a>
        <a href="/workspace" class="ml-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm shadow-indigo-500/20 transition-all hover:bg-indigo-500 hover:shadow-md hover:shadow-indigo-500/25">
          Open Workspace
        </a>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-6xl px-6 py-16">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-sm text-lokvis-muted animate-fade-in">
      <a href="/" class="transition-colors hover:text-indigo-500">Home</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-lokvis-fg font-medium">Image</span>
    </nav>

    <!-- Header -->
    <div class="mb-12 animate-fade-in-up">
      <div class="mb-4 flex items-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        </div>
        <div>
          <h1 class="text-4xl font-bold tracking-tight">Image Tools</h1>
          <p class="mt-1 text-lokvis-muted">Process images entirely in your browser. No uploads, no servers, 100% private.</p>
        </div>
      </div>
    </div>

    <!-- Tools Grid -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 stagger">
      {tools.map((tool) => (
        <a
          href={`/image/${tool.slug}`}
          class="animate-fade-in-up group relative overflow-hidden rounded-2xl border border-lokvis-border bg-lokvis-card p-8 transition-all hover:border-indigo-200 hover:shadow-lg hover:shadow-indigo-500/5 dark:hover:border-indigo-800"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100 dark:from-indigo-500/10"></div>
          <div class="relative">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 transition-colors group-hover:bg-indigo-100 dark:bg-indigo-950/50 dark:text-indigo-400 dark:group-hover:bg-indigo-900/50">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconMap[tool.icon]}></svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold">{tool.name}</h3>
            <p class="text-sm leading-relaxed text-lokvis-muted">{tool.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-medium text-indigo-600 opacity-0 transition-all group-hover:opacity-100 dark:text-indigo-400">
              Open tool
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
