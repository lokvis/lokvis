{
  "name": "Lokvis - Local-first Browser Workspace",
  "short_name": "Lokvis",
  "description": "Everything runs in your browser. No uploads. No servers. No compromises.",
  "start_url": "/workspace",
  "display": "standalone",
  "background_color": "#fafafa",
