{
  "name": "@lokvis/playground",
  "version": "0.1.0",
  "private": true,
  "description": "Lokvis Playground - Try the SDK in your browser",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "astro dev",
    "dev:stop": "astro dev stop",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "clean": "rm -rf dist .astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "@lokvis/capability": "workspace:*",
    "@lokvis/engine-image": "workspace:*",
    "@lokvis/plugin-dev": "workspace:*",
    "@lokvis/plugin-image": "workspace:*",
    "@lokvis/runtime": "workspace:*",
    "@lokvis/schema": "workspace:*",
    "@lokvis/sdk": "workspace:*",
    "@lokvis/ui-core": "workspace:*",
    "@lokvis/ui-react": "workspace:*",
    "@sentry/browser": "^8.40.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
