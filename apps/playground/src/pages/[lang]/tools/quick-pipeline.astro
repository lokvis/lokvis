---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { ImageQuickPipeline } from '@lokvis/quick-image';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---
<ToolLayout slug="quick-pipeline">
  <div class="mx-auto w-full max-w-3xl px-4 py-4">
    <ImageQuickPipeline client:only="react" initialPreset="ecommerce" locale={lang} />
  </div>
</ToolLayout>
