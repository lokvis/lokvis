---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import WatermarkBatchTool from '@/components/tools/WatermarkBatchTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="watermark-batch">
  <WatermarkBatchTool client:only="react" />
</ToolLayout>
