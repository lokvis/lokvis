---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import ImageQuickWatermark from '@/components/tools/quick/ImageQuickWatermark.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="quick-watermark">
  <div class="mx-auto w-full max-w-3xl px-4 py-4">
    <ImageQuickWatermark client:only="react" initialPreset="small-br" initialText="Lokvis" />
  </div>
</ToolLayout>
