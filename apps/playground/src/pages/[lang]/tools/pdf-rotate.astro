---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import PdfRotateTool from '@/components/tools/pdf/PdfRotateTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="pdf-rotate">
  <PdfRotateTool client:only="react" />
</ToolLayout>
