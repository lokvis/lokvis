---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import ConvertTool from '@/components/tools/ConvertTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="convert">
  <ConvertTool client:only="react" />
</ToolLayout>
