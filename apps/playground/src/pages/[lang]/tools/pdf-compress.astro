---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import PdfCompressTool from '@/components/tools/pdf/PdfCompressTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="pdf-compress">
  <PdfCompressTool client:only="react" />
</ToolLayout>
