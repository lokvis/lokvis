---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import PdfWatermarkTool from '@/components/tools/pdf/PdfWatermarkTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="pdf-watermark">
  <PdfWatermarkTool client:only="react" />
</ToolLayout>
