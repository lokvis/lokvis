---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import VideoThumbnailTool from '@/components/tools/video/VideoThumbnailTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="video-thumbnail">
  <VideoThumbnailTool client:only="react" />
</ToolLayout>
