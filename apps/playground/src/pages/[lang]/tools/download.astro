---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import DownloadManager from '@/components/tools/DownloadManager.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="download">
  <DownloadManager client:only="react" />
</ToolLayout>
