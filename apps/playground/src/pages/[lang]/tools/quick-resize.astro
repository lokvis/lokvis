---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { ImageQuickResize } from '@lokvis/quick-image';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="quick-resize">
  <div class="mx-auto w-full max-w-3xl px-4 py-4">
    <ImageQuickResize client:only="react" initialPreset="ig-square" />
  </div>
</ToolLayout>
