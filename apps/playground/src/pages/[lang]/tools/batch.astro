---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import BatchQueue from '@/components/tools/BatchQueue.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="batch">
  <BatchQueue client:only="react" />
</ToolLayout>
