---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import VideoTranscodeTool from '@/components/tools/video/VideoTranscodeTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="video-transcode">
  <VideoTranscodeTool client:only="react" />
</ToolLayout>
