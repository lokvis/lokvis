---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { ImageQuickCompress } from '@lokvis/quick-image';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="quick-compress">
  <div class="mx-auto w-full max-w-3xl px-4 py-4">
    <ImageQuickCompress client:only="react" initialPreset="balanced" />
  </div>
</ToolLayout>
