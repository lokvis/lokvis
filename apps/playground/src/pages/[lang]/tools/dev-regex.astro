---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import RegexTester from '@/components/tools/dev/RegexTester.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="dev-regex">
  <RegexTester client:only="react" />
</ToolLayout>
