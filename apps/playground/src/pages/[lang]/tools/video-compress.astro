---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import VideoCompressTool from '@/components/tools/video/VideoCompressTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="video-compress">
  <VideoCompressTool client:only="react" />
</ToolLayout>
