---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { PlaygroundImageQuickCrop } from '@/components/tools/quick/playground.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="quick-crop">
  <div class="mx-auto w-full max-w-3xl px-4 py-4">
    <PlaygroundImageQuickCrop client:only="react" initialPreset="square" />
  </div>
</ToolLayout>
