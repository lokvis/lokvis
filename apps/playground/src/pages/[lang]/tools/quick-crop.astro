---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { EmbedImageCrop } from '@lokvis/embed-image';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---
<ToolLayout slug="quick-crop">
  <div class="mx-auto w-full max-w-3xl px-4 py-4">
    <EmbedImageCrop client:only="react" initialPreset="square" mode="dark" locale={lang} />
  </div>
</ToolLayout>
