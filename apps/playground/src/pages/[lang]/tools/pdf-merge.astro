---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import PdfMergeTool from '@/components/tools/pdf/PdfMergeTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="pdf-merge">
  <PdfMergeTool client:only="react" />
</ToolLayout>
