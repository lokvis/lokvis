---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import AudioNormalizeTool from '@/components/tools/audio/AudioNormalizeTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="audio-normalize">
  <AudioNormalizeTool client:only="react" />
</ToolLayout>
