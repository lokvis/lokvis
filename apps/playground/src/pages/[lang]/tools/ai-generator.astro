---
import { langList } from '@/i18n/config';
import ToolLayout from '@/layouts/ToolLayout.astro';
import AiWorkflowGeneratorTool from '@/components/tools/ai/AiWorkflowGeneratorTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<ToolLayout slug="ai-generator">
  <AiWorkflowGeneratorTool client:only="react" />
</ToolLayout>
