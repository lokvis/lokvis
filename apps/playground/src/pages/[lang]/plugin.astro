---
import { langList } from '@/i18n/config';
import PlaygroundLayout from '@/layouts/PlaygroundLayout.astro';
import PluginDemo from '@/components/demos/PluginDemo.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<PlaygroundLayout title="Lokvis Playground · Plugin Loader" active="plugin">
  <PluginDemo client:only="react" />
</PlaygroundLayout>
