---
import { langList } from '@/i18n/config';
import PlaygroundLayout from '@/layouts/PlaygroundLayout.astro';
import RuntimeDemo from '@/components/demos/RuntimeDemo.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<PlaygroundLayout title="Lokvis Playground · Runtime Basics" active="runtime">
  <RuntimeDemo client:only="react" />
</PlaygroundLayout>
