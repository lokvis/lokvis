---
import { langList } from '@/i18n/config';
import PlaygroundLayout from '@/layouts/PlaygroundLayout.astro';
import ComponentsDemo from '@/components/demos/ComponentsDemo.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<PlaygroundLayout title="Lokvis Playground · UI Components" active="components">
  <ComponentsDemo client:only="react" />
</PlaygroundLayout>
