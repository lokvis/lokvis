---
import { langList } from '@/i18n/config';
import PlaygroundLayout from '@/layouts/PlaygroundLayout.astro';
import ImageWorkflowDemo from '@/components/demos/ImageWorkflowDemo.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<PlaygroundLayout title="Lokvis Playground · Image Workflow" active="image">
  <ImageWorkflowDemo client:only="react" />
</PlaygroundLayout>
