---
import { langList } from '@/i18n/config';
import PlaygroundLayout from '@/layouts/PlaygroundLayout.astro';
import HistoryDemo from '@/components/demos/HistoryDemo.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<PlaygroundLayout title="Lokvis Playground · Undo / Redo" active="history">
  <HistoryDemo client:only="react" />
</PlaygroundLayout>
