---
/**
 * G2:嵌入式 PDF 拆分工具页(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/pdf-split
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/pdf-split" />
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import PdfSplitTool from '@/components/tools/pdf/PdfSplitTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<EmbedLayout slug="pdf-split">
  <PdfSplitTool client:only="react" />
</EmbedLayout>
