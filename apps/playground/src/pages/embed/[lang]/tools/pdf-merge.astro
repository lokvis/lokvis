---
/**
 * G2:嵌入式 PDF 合并工具页(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/pdf-merge
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/pdf-merge" />
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
