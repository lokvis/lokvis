---
/**
 * 嵌入式一键图片压缩(quick compress)工具页。
 *
 * URL: /embed/en/tools/quick-compress
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/quick-compress" />
 *
 * 三方接入路径之一:零配置 iframe 嵌入。
 * 完全自定义请用 useQuickCompress() hook 或 QuickCompress 原语。
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import ImageQuickCompress from '@/components/tools/quick/ImageQuickCompress.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<EmbedLayout slug="quick-compress">
  <div class="mx-auto w-full max-w-3xl py-2">
    <ImageQuickCompress client:only="react" initialPreset="balanced" />
  </div>
</EmbedLayout>
