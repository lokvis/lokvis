---
/**
 * G2:嵌入式图片压缩工具页(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/compress
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/compress" />
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import CompressTool from '@/components/tools/CompressTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<EmbedLayout slug="compress">
  <CompressTool client:only="react" />
</EmbedLayout>
