---
/**
 * G2:嵌入式 PDF 旋转工具页(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/pdf-rotate
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/pdf-rotate" />
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import PdfRotateTool from '@/components/tools/pdf/PdfRotateTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<EmbedLayout slug="pdf-rotate">
  <PdfRotateTool client:only="react" />
</EmbedLayout>
