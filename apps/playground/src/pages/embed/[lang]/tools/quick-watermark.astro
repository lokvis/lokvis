---
/**
 * 嵌入式一键图片加水印(quick watermark)工具页。
 *
 * URL: /embed/en/tools/quick-watermark
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/quick-watermark" />
 *
 * 三方接入路径之一:零配置 iframe 嵌入。
 * 完全自定义请用 useQuickWatermark() hook 或 QuickWatermark 原语。
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import { ImageQuickWatermark } from '@lokvis/quick-image';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<EmbedLayout slug="quick-watermark">
  <div class="mx-auto w-full max-w-3xl py-2">
    <ImageQuickWatermark client:only="react" initialPreset="small-br" initialText="Lokvis" />
  </div>
</EmbedLayout>
