---
/**
 * G2:嵌入式图片格式转换工具页(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/convert
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/convert" />
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import ConvertTool from '@/components/tools/ConvertTool.tsx';
import { resolveAvifWasmUrl } from '@lokvis/engine-image';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}

// W21.2: 嵌入转换工具支持 AVIF 输出,预加载 WASM 编码器兜底
const avifWasmUrl = resolveAvifWasmUrl();
---
<EmbedLayout slug="convert" wasmPreload={[avifWasmUrl]}>
  <ConvertTool client:only="react" />
</EmbedLayout>
