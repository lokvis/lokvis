---
/**
 * 嵌入式 Base64 编解码工具(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/dev-base64
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import Base64Tool from '@/components/tools/dev/Base64Tool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<EmbedLayout slug="dev-base64">
  <Base64Tool client:only="react" />
</EmbedLayout>
