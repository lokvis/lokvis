---
/**
 * G2:嵌入式视频转 GIF 工具页(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/video-to-gif
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/video-to-gif" />
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import VideoToGifTool from '@/components/tools/video/VideoToGifTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<EmbedLayout slug="video-to-gif">
  <VideoToGifTool client:only="react" />
</EmbedLayout>
