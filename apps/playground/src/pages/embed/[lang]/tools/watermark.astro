---
/**
 * G2:嵌入式图片加水印工具页(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/watermark
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/watermark" />
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
