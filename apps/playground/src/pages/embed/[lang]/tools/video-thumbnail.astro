---
/**
 * G2:嵌入式视频缩略图工具页(cloud apps/web iframe 引用)。
 *
 * URL: /embed/en/tools/video-thumbnail
 * 引用方:<iframe src="https://playground.lokvis.dev/embed/en/tools/video-thumbnail" />
 */
import { langList } from '@/i18n/config';
import EmbedLayout from '@/layouts/EmbedLayout.astro';
import VideoThumbnailTool from '@/components/tools/video/VideoThumbnailTool.tsx';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}
---
<EmbedLayout slug="video-thumbnail">
  <VideoThumbnailTool client:only="react" />
</EmbedLayout>
