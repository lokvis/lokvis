---
/**
 * G2:嵌入式工具索引页(cloud apps/web 开发者参考)。
 *
 * 列出所有可用嵌入 URL,提供 iframe 代码片段,便于 cloud apps/web 直接复制使用。
 *
 * URL: /embed/en/ 或 /embed/zh/
 */
import { langList } from '@/i18n/config';
import { getLangFromUrl, t } from '@/i18n/utils';
import { TOOL_SEO } from '@/components/tools/seo';
import PlaygroundLayout from '@/layouts/PlaygroundLayout.astro';

export function getStaticPaths() {
  return langList.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const tr = (key: string) => t(lang, key);

// 按 category 分组(与 TOOL_SEO 顺序一致)
const EMBED_TOOLS = [
  // image
  { slug: 'compress', category: 'image' },
  { slug: 'resize', category: 'image' },
  { slug: 'convert', category: 'image' },
  { slug: 'crop', category: 'image' },
  { slug: 'watermark', category: 'image' },
  { slug: 'watermark-batch', category: 'image' },
  { slug: 'batch', category: 'image' },
  { slug: 'download', category: 'image' },
  // pdf
  { slug: 'pdf-compress', category: 'pdf' },
  { slug: 'pdf-rotate', category: 'pdf' },
  { slug: 'pdf-watermark', category: 'pdf' },
  { slug: 'pdf-split', category: 'pdf' },
  { slug: 'pdf-merge', category: 'pdf' },
  { slug: 'pdf-extract-pages', category: 'pdf' },
  // video
  { slug: 'video-compress', category: 'video' },
  { slug: 'video-transcode', category: 'video' },
  { slug: 'video-trim', category: 'video' },
  { slug: 'video-to-gif', category: 'video' },
  { slug: 'video-thumbnail', category: 'video' },
  // audio
  { slug: 'audio-trim', category: 'audio' },
  { slug: 'audio-normalize', category: 'audio' },
  { slug: 'audio-transcode', category: 'audio' },
  { slug: 'audio-merge', category: 'audio' },
  // ai
  { slug: 'ai-generator', category: 'ai' },
] as const;

const CATEGORIES: Record<string, { titleKey: string }> = {
  image: { titleKey: 'embed.cat.image' },
  pdf: { titleKey: 'embed.cat.pdf' },
  video: { titleKey: 'embed.cat.video' },
  audio: { titleKey: 'embed.cat.audio' },
  ai: { titleKey: 'embed.cat.ai' },
};

const base = import.meta.env.BASE_URL;
const site = Astro.site?.toString() ?? 'https://playground.lokvis.dev';
const embedBase = `${site}${base}embed/${lang}/tools/`;
---
<PlaygroundLayout
  title={`${tr('embed.title')} · Lokvis Playground`}
  active="embed"
  description={tr('embed.subtitle')}
>
  <section class="mx-auto w-full max-w-5xl px-4 py-6">
    <header class="mb-6">
      <h1 class="text-lg font-semibold text-zinc-100">{tr('embed.title')}</h1>
      <p class="mt-1 text-xs text-zinc-500">{tr('embed.subtitle')}</p>
      <p class="mt-2 text-[11px] text-zinc-600">{tr('embed.usage')}</p>
    </header>

    {Object.entries(CATEGORIES).map(([cat, { titleKey }]) => (
      <div class="mb-6">
        <h2 class="mb-2 text-sm font-semibold text-zinc-300">{tr(titleKey)}</h2>
        <div class="grid grid-cols-1 gap-2">
          {EMBED_TOOLS.filter((tool) => tool.category === cat).map((tool) => {
            const seo = TOOL_SEO[tool.slug];
            const url = `${embedBase}${tool.slug}`;
            const iframeCode = `<iframe src="${url}" title="${seo.title}" width="100%" height="600" loading="lazy" allow="clipboard-write" sandbox="allow-scripts allow-same-origin allow-downloads"></iframe>`;
            return (
              <div class="rounded-lg border border-zinc-800 bg-zinc-900/40 p-3">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <div class="text-xs font-semibold text-zinc-100">{seo.title}</div>
                    <div class="mt-0.5 text-[11px] text-zinc-500">{seo.description}</div>
                  </div>
                  <a
                    href={`${base}${lang}/tools/${tool.slug}`}
                    target="_blank"
                    rel="noopener"
                    class="rounded border border-zinc-700 px-2 py-1 text-[10px] text-zinc-300 hover:bg-zinc-800"
                  >
                    {tr('embed.preview')}
                  </a>
                </div>
                <pre class="mt-2 overflow-x-auto rounded bg-zinc-950 px-2 py-1.5 text-[10px] leading-relaxed text-emerald-300"><code>{iframeCode}</code></pre>
              </div>
            );
          })}
        </div>
      </div>
    ))}

    <div class="mt-6 rounded-lg border border-indigo-700/40 bg-indigo-900/10 p-3 text-[11px] text-zinc-300">
      <div class="mb-1 font-semibold text-indigo-300">{tr('embed.postMessageTitle')}</div>
      <p class="text-zinc-400">{tr('embed.postMessageDesc')}</p>
      <pre class="mt-2 overflow-x-auto rounded bg-zinc-950 px-2 py-1.5 text-[10px] leading-relaxed text-sky-300"><code>{`window.addEventListener('message', (e) => {
  if (e.data?.type === 'lokvis:embed:ready') console.log('embed ready:', e.data.slug);
  if (e.data?.type === 'lokvis:embed:height') iframe.height = e.data.height;
});`}</code></pre>
    </div>
  </section>
</PlaygroundLayout>
