---
import '../styles/global.css';
import { getLangFromUrl, t, switchLangPath, type Language } from '@/i18n/utils';
import { langList } from '@/i18n/config';

/**
 * Playground 极简壳（W14.1 升级 + i18n）
 *
 * 设计目标：开发者试用 @lokvis/sdk 的最小容器。
 * 不含商业化元素（Workspace 组件、付费墙、广告）—— 那些在 cloud/apps/web。
 *
 * Layout 结构：顶部品牌条 + 左侧 sidebar 导航 + 右侧内容区。
 *
 * i18n：从 URL 路径自动提取 lang（/en/xxx 或 /zh/xxx），导航文案 + href 跟随语言。
 * 语言切换器在顶部品牌条右侧，切换时保留当前页面路径。
 *
 * 所有分组都支持展开/收起（<details>）；若分组内含当前 active 项，默认展开。
 */

interface Props {
  title?: string;
  /** 当前激活的 sidebar 项 ID(对应 NAV_GROUPS 中 item.id) */
  active?: string;
  /** SEO description(覆盖默认)。W8.7 工具页通过 ToolLayout 注入 */
  description?: string;
  /** SEO keywords(逗号分隔)。可选 */
  keywords?: string;
  /** OG 标题(覆盖 title)。可选 */
  ogTitle?: string;
  /** OG 描述(默认取 description)。可选 */
  ogDescription?: string;
  /** OG 图像 URL 或 data URI。可选 */
  ogImage?: string;
  /** OG 类型,默认 website */
  ogType?: string;
}

const {
  title = 'Lokvis Playground',
  active = 'home',
  description = 'Lokvis Playground — try @lokvis/sdk in your browser',
  keywords,
  ogTitle,
  ogDescription,
  ogImage,
  ogType = 'website',
} = Astro.props;

// 从 URL 自动提取语言（/en/sdk → 'en'，/zh/sdk → 'zh'）
const lang: Language = getLangFromUrl(Astro.url);
const tr = (key: string) => t(lang, key);

const finalOgTitle = ogTitle ?? title;
const finalOgDescription = ogDescription ?? description;

// Base 路径处理：astro.config.mjs 配置 `base: '/'`（W14.7 起 playground 部署到根域），
// 导航 href 通过 import.meta.env.BASE_URL 拼接，确保 base 变更时路径自动跟随。
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// 语言前缀化的 base：/en/ 或 /zh/
const langBase = `${base}${lang}/`;

// PWA UI 组件（W15.4 / W15.5 / W15.8）
// client:only="react" —— 仅客户端渲染，避免 SSR 时 window/localStorage 未定义
import InstallPrompt from '@/components/pwa/InstallPrompt.tsx';
import OfflineIndicator, { OfflineStatusDot } from '@/components/pwa/OfflineIndicator.tsx';
import EngineLoader from '@/components/pwa/EngineLoader.tsx';

// 导航分三组（label/desc 改为翻译 key，href 加 lang 前缀）
interface NavItem {
  id: string;
  labelKey: string;
  href: string;
  descKey: string;
}
interface NavGroup {
  titleKey: string;
  items: NavItem[];
}
const NAV_GROUPS: NavGroup[] = [
  {
    titleKey: 'nav.demos.title',
    items: [
      { id: 'home', labelKey: 'nav.home.label', href: langBase, descKey: 'nav.home.desc' },
      { id: 'sdk', labelKey: 'nav.sdk.label', href: `${langBase}sdk`, descKey: 'nav.sdk.desc' },
      { id: 'runtime', labelKey: 'nav.runtime.label', href: `${langBase}runtime`, descKey: 'nav.runtime.desc' },
      { id: 'plugin', labelKey: 'nav.plugin.label', href: `${langBase}plugin`, descKey: 'nav.plugin.desc' },
      { id: 'workflow', labelKey: 'nav.workflow.label', href: `${langBase}workflow`, descKey: 'nav.workflow.desc' },
      { id: 'mcp', labelKey: 'nav.mcp.label', href: `${langBase}mcp`, descKey: 'nav.mcp.desc' },
    ],
  },
  {
    titleKey: 'nav.tools.title',
    items: [
      { id: 'tools/compress', labelKey: 'nav.tools.compress.label', href: `${langBase}tools/compress`, descKey: 'nav.tools.compress.desc' },
      { id: 'tools/resize', labelKey: 'nav.tools.resize.label', href: `${langBase}tools/resize`, descKey: 'nav.tools.resize.desc' },
      { id: 'tools/convert', labelKey: 'nav.tools.convert.label', href: `${langBase}tools/convert`, descKey: 'nav.tools.convert.desc' },
      { id: 'tools/crop', labelKey: 'nav.tools.crop.label', href: `${langBase}tools/crop`, descKey: 'nav.tools.crop.desc' },
      { id: 'tools/watermark', labelKey: 'nav.tools.watermark.label', href: `${langBase}tools/watermark`, descKey: 'nav.tools.watermark.desc' },
      { id: 'tools/watermark-batch', labelKey: 'nav.tools.watermarkBatch.label', href: `${langBase}tools/watermark-batch`, descKey: 'nav.tools.watermarkBatch.desc' },
      { id: 'tools/batch', labelKey: 'nav.tools.batch.label', href: `${langBase}tools/batch`, descKey: 'nav.tools.batch.desc' },
      { id: 'tools/download', labelKey: 'nav.tools.download.label', href: `${langBase}tools/download`, descKey: 'nav.tools.download.desc' },
    ],
  },
  {
    titleKey: 'nav.more.title',
    items: [
      { id: 'image', labelKey: 'nav.image.label', href: `${langBase}image`, descKey: 'nav.image.desc' },
      { id: 'history', labelKey: 'nav.history.label', href: `${langBase}history`, descKey: 'nav.history.desc' },
      { id: 'components', labelKey: 'nav.components.label', href: `${langBase}components`, descKey: 'nav.components.desc' },
    ],
  },
];

// 当前页面路径（用于语言切换器计算目标 URL）
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* PWA 基础设施（W15.1 + review fix）：manifest + theme-color + 图标 + iOS Safari 兼容
        icon-192.png / icon-512.png / icon-maskable-512.png 由 scripts/generate-pwa-icons.mjs 生成 */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#6366f1" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Lokvis" />

    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>

    {/* Open Graph(W8.7)—— 分享到 Twitter/微信/Slack 时显示卡片预览 */}
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalOgDescription} />
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:site_name" content="Lokvis Playground" />

    {/* Twitter Card(W8.7)*/}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalOgDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* Sentry 监控接入(W12.3)
        - DSN 通过 PUBLIC_SENTRY_DSN 注入,未配置时为 no-op
        - SDK 走 ES dynamic import 懒加载,不进首屏 bundle
        - 遵循 DNT,用户拒绝跟踪时不上报
        - 隐私保护:beforeBreadcrumb 剔除可能含文件名的输入,只保留 category */}
    <script>
      import { initSentry } from '@/toolkit/sentry.js';
      initSentry();
    </script>
  </head>
  <body class="h-screen overflow-hidden bg-zinc-950 text-zinc-100">
    {/* PWA OfflineIndicator banner（W15.5）—— 顶部固定，离线时滑入 */}
    <OfflineIndicator client:only="react" />

    <div class="flex h-full flex-col">
      {/* 顶部品牌条 */}
      <header class="flex items-center justify-between border-b border-zinc-800 bg-zinc-950 px-5 py-3">
        <div class="flex items-center gap-3">
          <span class="text-lg font-bold" style="background: linear-gradient(135deg, #6366f1, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">◆</span>
          <span class="text-sm font-semibold tracking-tight">{tr('header.brand')}</span>
          <span class="hidden rounded-full bg-zinc-900 px-2 py-0.5 text-[10px] font-medium text-zinc-500 sm:inline">{tr('header.tag')}</span>
        </div>
        <div class="flex items-center gap-3">
          {/* PWA 在线状态点（W15.5）—— 绿色在线 / 红色离线 */}
          <OfflineStatusDot client:only="react" />
          {/* 语言切换器：切换时保留当前页面路径 */}
          <div class="flex items-center gap-1 rounded-md border border-zinc-800 bg-zinc-900 px-1 py-0.5 text-[10px]">
            {langList.map((l) => (
              <a
                href={switchLangPath(currentPath, l)}
                class={`rounded px-1.5 py-0.5 font-medium transition-colors ${
                  l === lang ? 'bg-indigo-600 text-white' : 'text-zinc-500 hover:text-zinc-300'
                }`}
                aria-current={l === lang ? 'true' : undefined}
              >{l.toUpperCase()}</a>
            ))}
          </div>
          <a href="https://lokvis.com" class="text-xs text-zinc-500 transition-colors hover:text-indigo-400">{tr('header.cloud')}</a>
        </div>
      </header>

      <div class="flex flex-1 overflow-hidden">
        {/* Sidebar 导航(分组:Demos + Tools W5 + More,全部可展开/收起)*/}
        <aside class="hidden w-60 flex-shrink-0 overflow-y-auto border-r border-zinc-800 bg-zinc-950/50 md:flex md:flex-col">
          <nav class="flex flex-1 flex-col gap-3 p-3">
            {NAV_GROUPS.map((group) => {
              // 若分组内含当前 active 项,默认展开
              const containsActive = group.items.some((item) => item.id === active);
              return (
                <details class="group flex flex-col gap-1" open={containsActive}>
                  <summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-zinc-600 transition-colors hover:bg-zinc-900 hover:text-zinc-400">
                    <span>{tr(group.titleKey)}</span>
                    <span class="text-zinc-600 transition-transform group-open:rotate-90">›</span>
                  </summary>
                  <div class="flex flex-col gap-1">
                    {group.items.map((item) => (
                      <a
                        href={item.href}
                        id={active === item.id ? 'active-nav-item' : undefined}
                        class={`group rounded-md px-3 py-2 text-xs transition-colors ${
                          active === item.id
                            ? 'bg-indigo-600/10 text-indigo-400 ring-1 ring-inset ring-indigo-500/20'
                            : 'text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200'
                        }`}
                      >
                        <div class="font-semibold">{tr(item.labelKey)}</div>
                        <div class={`mt-0.5 text-[10px] ${active === item.id ? 'text-indigo-400/70' : 'text-zinc-600 group-hover:text-zinc-500'}`}>{tr(item.descKey)}</div>
                      </a>
                    ))}
                  </div>
                </details>
              );
            })}
          </nav>
          <div class="border-t border-zinc-800 p-3 text-[10px] text-zinc-600">
            <div>{tr('sidebar.sdkVersion')} <span class="text-zinc-400">@0.1.0</span></div>
            <div class="mt-0.5">{tr('sidebar.runsLocally')}</div>
          </div>
        </aside>

        {/* 内容区 */}
        <main class="flex flex-1 flex-col overflow-hidden">
          <slot />
        </main>
      </div>

      {/* 将激活的导航项滚动到视野内(页面刷新后定位) */}
      <script>
        // 使用 block:'nearest' 避免不必要的滚动;仅当激活项不在视野内时才滚动
        const el = document.getElementById('active-nav-item');
        if (el) el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      </script>
    </div>

    {/* PWA InstallPrompt（W15.4）—— 捕获 beforeinstallprompt + 底部安装 banner
        client:only="react"：避免 SSR 时 window 事件 / localStorage 不可用 */}
    <InstallPrompt client:only="react" />

    {/* PWA EngineLoader（W15.8）—— 首次加载 engine 进度条 + 预估时间 + 重试
        client:only="react"：依赖 sessionStorage / engine-image lazy 接口 */}
    <EngineLoader client:only="react" />

    {/* Service Worker 注册（W15.1）+ 消息监听（W15.7 + review fix）
        - 仅 production 注册，dev 模式跳过避免缓存干扰 HMR
        - scope: '/' 根域（base 已配置为 '/'）
        - sw.js 在 public/ 下，Astro 原样输出到 dist 根
        - W15.7：监听 SW_ACTIVATED → 调 preloadTop5Operations() 后台预加载 top 5 engine chunk
          （dynamic import 触发 chunk fetch，SW 的 immutable/SWR 缓存自然生效）
        - Review fix（Major-2）：import 从 @lokvis/engine-image/lazy.js 改为
          @lokvis/plugin-image（Capability 层），避免 UI → Engine 跨层引用
        - Review fix（Minor-5）：message 监听器添加 pagehide 清理，避免 bfcache 恢复时重复绑定
        - Review fix（Minor-6）：SW_INSTALLED 区分首次安装（无需 reload）与更新（需 reload） */}
    {import.meta.env.PROD && (
      <script>
        if ('serviceWorker' in navigator) {
          // 监听 SW 消息（必须在 register 前注册，避免错过早期 activate 通知）
          const handleSWMessage = (event: MessageEvent) => {
            try {
              const data = event.data || {};
              if (data.type === 'SW_ACTIVATED') {
                // SW 已激活 → 后台预加载 top 5 operation（通过 Capability 层 import，
                // ESM dynamic import 触发浏览器 fetch 对应 chunk，SW 缓存自然接管）。
                // 失败静默，不影响主流程。
                import('@lokvis/plugin-image')
                  .then((m) => m.preloadTop5Operations())
                  .then((loaded) => console.log('[SW] top5 preloaded:', loaded))
                  .catch((err) => console.warn('[SW] top5 preload failed:', err));
              } else if (data.type === 'SW_INSTALLED') {
                // Review fix（Minor-6）：区分首次安装与更新
                // skipWaiting() 使新 SW 立即接管；首次安装时页面无旧 SW 控制，无需 reload；
                // 仅更新场景下新 SW 接管后需 reload 才能用新资源。
                navigator.serviceWorker.getRegistration().then((reg) => {
                  if (!reg) {
                    console.log('[SW] first install, version:', data.version);
                  } else {
                    console.log('[SW] update installed, reload to activate:', data.version);
                  }
                });
              }
            } catch (err) {
              console.warn('[SW] message handler error:', err);
            }
          };
          navigator.serviceWorker.addEventListener('message', handleSWMessage);

          // Review fix（Minor-5）：页面卸载时移除监听器，避免 bfcache 恢复时重复绑定
          window.addEventListener('pagehide', () => {
            navigator.serviceWorker.removeEventListener('message', handleSWMessage);
          }, { once: true });

          window.addEventListener('load', () => {
            // Review fix（Minor）：SW 路径与 scope 从 BASE_URL 派生，
            // 避免 playground 部署到子路径时 SW 注册到错误 scope。
            // （base='/' 时退化为原行为 '/sw.js' + scope '/'）
            const swBase = import.meta.env.BASE_URL;
            navigator.serviceWorker.register(`${swBase}sw.js`, { scope: swBase })
              .then((reg) => console.log('[SW] registered', reg.scope))
              .catch((err) => console.warn('[SW] registration failed', err));
          });
        }
      </script>
    )}
    {import.meta.env.DEV && (
      <script>
        // Dev 模式:注销残留的 Service Worker,避免 SW 的 stale-while-revalidate
        // 缓存拦截 Vite 的 /@fs/ 模块请求,导致 workspace 包(如 @lokvis/runtime)
        // 的更新不生效(浏览器拿到 SW 缓存的旧版代码)。
        // 常见触发场景:之前跑过 production build / preview,或早期版本 dev 模式
        // 也注册过 SW。残留 SW 在 dev 模式下持续拦截请求,HMR 失效。
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then((regs) => {
            if (regs.length > 0) {
              Promise.all(regs.map((r) => r.unregister())).then(() => {
                console.log('[SW] unregistered stale service workers in dev mode');
              });
            }
          });
          // 同时清理 SW 缓存(caches API),避免 stale-while-revalidate
          // 命中旧缓存仍返回旧版模块
          if (window.caches && typeof caches.keys === 'function') {
            caches.keys().then((keys) => {
              Promise.all(keys.map((k) => caches.delete(k))).then(() => {
                if (keys.length > 0) {
                  console.log('[SW] cleared stale caches in dev mode:', keys.length);
                }
              });
            });
          }
        }
      </script>
    )}
  </body>
</html>
