---
/**
 * ToolLayout — 工具页 SEO + 隐私声明 包装层(W8.7 / W8.8 / W17.11)。
 *
 * 用法:工具页 .astro 用 ToolLayout 替代 PlaygroundLayout,只需传 slug:
 *
 *   ---
 *   import ToolLayout from '@/layouts/ToolLayout.astro';
 *   import CompressTool from '@/components/tools/CompressTool.tsx';
 *   ---
 *   <ToolLayout slug="compress">
 *     <CompressTool client:only="react" />
 *   </ToolLayout>
 *
 * ToolLayout 根据 slug 从 TOOL_SEO 查表得到 title/description/keywords,
 * 计算 OG 图像的绝对 URL(指向 `src/pages/og/[slug].png.ts` 构建期生成的 PNG),
 * 透传给 PlaygroundLayout。
 *
 * W8.8:工具页顶部注入 PrivacyBadge(隐私声明 + 断网验证入口),
 *      让用户在每次使用工具时都能看到"文件未上传"承诺。
 * W17.11:工具页底部注入 "Why use Lokvis?" 对比卡片(4 张):
 *      Privacy(upload)/ Speed(response)/ Free(tokens)/ Offline,
 *      与 AI 对话工具(ChatGPT / Claude / Gemini)对比差异,
 *      帮助用户在工具页直接看到 Lokvis 与 AI 的取舍。
 */
import PlaygroundLayout from './PlaygroundLayout.astro';
import { PrivacyBadge } from '@/components/toolkit/PrivacyBadge';
import { TOOL_SEO } from '@/components/tools/seo';
import { getLangFromUrl, t } from '@/i18n/utils';

interface Props {
  /** 工具 slug,对应 TOOL_SEO 的 key,如 'compress' */
  slug: string;
  /** 当前激活的 sidebar 项 ID(默认 `tools/${slug}`) */
  active?: string;
  /**
   * W21.2: WASM 资源预加载 URL 列表,透传给 PlaygroundLayout。
   * AVIF 输出类工具页(convert/compress/quick-*)传入
   * `resolveAvifWasmUrl()`,浏览器空闲时预取编码器 wasm。
   */
  wasmPreload?: string[];
}

const { slug, active = `tools/${slug}`, wasmPreload = [] } = Astro.props;
const seo = TOOL_SEO[slug];
const lang = getLangFromUrl(Astro.url);
const tr = (key: string) => t(lang, key);

if (!seo) {
  throw new Error(
    `ToolLayout: slug "${slug}" 不在 TOOL_SEO 中。请在 components/tools/seo.ts 注册该工具的 SEO 元数据。`
  );
}

const fullTitle = `${seo.title} · Lokvis Playground`;
// OG 图像:指向构建期生成的 PNG 端点(og/<slug>.png),拼接 base + site 得到绝对 URL。
// og:image 规范要求绝对 HTTPS URL,data URI / 相对路径 / SVG 均不被平台接受。
const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}og/${slug}.png`, Astro.site).toString();
const keywords = seo.keywords?.join(', ');

// W17.11: "Why use Lokvis?" 4 张对比卡片(upload / response / tokens / offline)
const WHY_CARDS = [
  { titleKey: 'whylokvis.uploadTitle', lokvisKey: 'whylokvis.uploadLokvis', aiKey: 'whylokvis.uploadAi', icon: '🔒' },
  { titleKey: 'whylokvis.responseTitle', lokvisKey: 'whylokvis.responseLokvis', aiKey: 'whylokvis.responseAi', icon: '⚡' },
  { titleKey: 'whylokvis.tokensTitle', lokvisKey: 'whylokvis.tokensLokvis', aiKey: 'whylokvis.tokensAi', icon: '💸' },
  { titleKey: 'whylokvis.offlineTitle', lokvisKey: 'whylokvis.offlineLokvis', aiKey: 'whylokvis.offlineAi', icon: '📡' },
] as const;
---
<PlaygroundLayout
  title={fullTitle}
  active={active}
  description={seo.description}
  keywords={keywords}
  ogTitle={seo.title}
  ogDescription={seo.description}
  ogImage={ogImage}
  ogType="website"
  wasmPreload={wasmPreload}
>
  <div class="relative flex flex-col gap-2 px-4 py-2">
    <PrivacyBadge client:load lang={lang} />
  </div>
  <slot />
  {/* W17.11:Why use Lokvis? vs AI 对比卡片(工具页底部) */}
  <section class="mx-auto w-full max-w-5xl px-4 py-8">
    <header class="mb-4">
      <h2 class="text-sm font-semibold text-zinc-200">{tr('whylokvis.title')}</h2>
      <p class="mt-0.5 text-[11px] text-zinc-500">{tr('whylokvis.subtitle')}</p>
    </header>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {WHY_CARDS.map((card) => (
        <div class="flex flex-col gap-1.5 rounded-lg border border-zinc-800 bg-zinc-900/40 p-3">
          <div class="flex items-center gap-1.5 text-xs font-medium text-zinc-200">
            <span aria-hidden>{card.icon}</span>
            <span>{tr(card.titleKey)}</span>
          </div>
          <p class="text-[11px] leading-relaxed text-zinc-400">{tr(card.lokvisKey)}</p>
          <p class="mt-auto border-t border-zinc-800 pt-1.5 text-[10px] leading-relaxed text-amber-400/80">{tr(card.aiKey)}</p>
        </div>
      ))}
    </div>
  </section>
</PlaygroundLayout>
