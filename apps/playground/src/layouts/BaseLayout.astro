---
import '../styles/global.css';
import { Playground } from '../components/Playground.tsx';

interface Props {
  title?: string;
}

const { title = 'Lokvis Playground' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Try Lokvis SDK in your browser" />
    <title>{title}</title>
  </head>
  <body>
    <Playground client:only="react" />
  </body>
</html>
