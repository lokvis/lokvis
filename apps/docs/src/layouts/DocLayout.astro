---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lokvis Docs',
  description = 'Local-first Browser Workspace - Documentation',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="layout">
      <nav class="sidebar">
        <a href="/" class="brand">◆ Lokvis</a>
        <ul>
          <li><a href="/docs/">Overview</a></li>
          <li><a href="/docs/architecture">Architecture</a></li>
          <li><a href="/docs/getting-started">Getting Started</a></li>
          <li><a href="/docs/capabilities">Capabilities</a></li>
          <li><a href="/docs/plugins">Plugins</a></li>
          <li><a href="/docs/workflows">Workflows</a></li>
          <li><a href="/docs/sdk">SDK</a></li>
          <li><a href="/docs/cli">CLI</a></li>
          <li><a href="/docs/roadmap">Roadmap</a></li>
        </ul>
      </nav>
      <main class="content">
        <slot />
      </main>
    </div>
    <style>
      .layout { display: flex; min-height: 100vh; }
      .sidebar { width: 240px; flex: none; border-right: 1px solid var(--color-border); padding: 1rem; }
      .brand { display: block; font-weight: 600; margin-bottom: 1rem; }
      .sidebar ul { list-style: none; padding: 0; margin: 0; font-size: 0.875rem; }
      .sidebar li { margin: 0.25rem 0; }
      .content { flex: 1; overflow: auto; padding: 2rem; max-width: 800px; }
      h1, h2, h3 { margin-top: 1.5em; }
      code { background: #f4f4f5; padding: 0.1em 0.3em; border-radius: 3px; font-size: 0.875em; }
      pre code { background: transparent; padding: 0; }
      ul, ol { padding-left: 1.5em; }
      @media (prefers-color-scheme: dark) {
        code { background: #18181b; }
      }
    </style>
  </body>
</html>
